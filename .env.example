# TODO(DevOps - user): this documents the variables the backend will need
# once the data layer (Postgres/Redis) is actually wired up - none of them
# are consumed by code yet. Copy this to `.env` for local dev.
#
# In deployment, these should come from a secrets manager, not a committed
# .env file - e.g. GitHub Actions "Secrets" for CI, or your cloud provider's
# secret store (AWS Secrets Manager, GCP Secret Manager, etc.) for
# production. Never commit a real .env file - it's already in .gitignore.

# Matches docker-compose.yml's postgres service.
DATABASE_URL=postgresql://hyllvy:hyllvy_dev_only@localhost:5432/hyllvy

# Matches docker-compose.yml's redis service.
REDIS_URL=redis://localhost:6379

# Backend HTTP port (see apps/backend/src/main.ts).
PORT=3000
